<!doctype html>
<html lang="en">
<head>
  <title>jekyll-icon-flow demo</title>
  <meta charset="utf-8">
  <style>
    body{font-family:system-ui,sans-serif;margin:0;padding:28px 32px;background:#fafafa;color:#1f2937}
    h1{font-size:20px;margin:0 0 4px}
    h2{font-size:13px;color:#6b7280;margin:0 0 26px;font-weight:500}
    section{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 18px;margin-bottom:14px}
    .row{display:flex;gap:26px;align-items:center;flex-wrap:wrap}
    .card{display:flex;flex-direction:column;gap:6px;font-size:15px}
    code{font:12px/1.4 ui-monospace,monospace;background:#f3f4f6;padding:2px 6px;border-radius:4px;color:#6b21a8}
    .icon{display:inline-block;vertical-align:-0.125em;font-size:22px}
    .row .icon{font-size:26px}
    small{color:#9ca3af;font-size:10px}
    body[data-step="1"] .s1,body[data-step="2"] .s2,body[data-step="3"] .s3{outline:3px solid #a78bfa;outline-offset:-3px}
  </style>
</head>
<body>
  <h1>jekyll-icon-flow</h1>
  <h2>Pack-agnostic inline SVG icons - same styling contract across packs</h2>
  <section class="s1"><div class="row"><%= pack_examples %></div></section>
  <section class="s2"><div class="row">
    <%= size_examples %>
    <div class="card"><code>size:xs through xxl or any CSS size</code></div>
  </div></section>
  <section class="s3"><div class="row">
    <%= color_examples %>
    <div class="card"><code>currentColor inherits text color</code></div>
  </div></section>
  <section><div class="row"><div class="card"><span><%= icon_ref_example %></span>
    <code>{% icon_ref download size:1.5em class:"has-text-link" title:"Download" %}</code>
  </div></div></section>
  <script>document.body.dataset.step=new URLSearchParams(location.search).get("step")||"0"</script>
</body>
</html>
